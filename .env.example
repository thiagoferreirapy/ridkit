# Gere um segredo longo e aleatório antes de publicar.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-bytes
ADMIN_JWT_SECRET=use-outro-segredo-aleatorio-exclusivo-para-o-admin
NEWSLETTER_SECRET=terceiro-segredo-para-links-de-descadastro
# Obrigatório em produção: base dos links enviados por e-mail.
ADMIN_EMAIL=admin@ridekit.com.br
ADMIN_PASSWORD=troque-esta-senha-antes-de-publicar
DATABASE_PATH=./data/ridekit.sqlite
APP_URL=http://localhost:3000
# Defina como 1 somente quando a aplicação estiver atrás de um proxy reverso que
# sobrescreve X-Forwarded-For (nginx, Caddy, Cloudflare). Sem isso o header é ignorado
# no rate limit, porque qualquer cliente pode forjá-lo.
TRUSTED_PROXY=0
RESEND_API_KEY=
EMAIL_FROM=Ridekit <onboarding@resend.dev>
CONTACT_EMAIL=ajuda@ridekit.com.br
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
